# Database connection for the API. Copy to .env and adjust only if you are not
# using the bundled docker-compose service. The values below match it exactly,
# and application.yml falls back to these same defaults, so the app runs with
# no .env file at all in local development.
#
# Export before running if you override them:
#   export $(grep -v '^#' .env | xargs)

DB_URL=jdbc:mysql://localhost:3306/emailautomata?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=emailautomata
DB_PASSWORD=emailautomata
SPRING_PROFILES_ACTIVE=dev